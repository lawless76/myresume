---
import { experience } from '@/data/experience';
---

<section id="experience" class="py-10 px-6 md:px-10 border-b border-slate-100">
  <div class="mb-8">
    <span class="text-xs font-semibold text-red-600 uppercase tracking-widest">Career</span>
    <h2 class="mt-1 text-2xl font-bold text-slate-900">Experience</h2>
  </div>

  <div class="space-y-8">
    {experience.map((role) => (
      <div>
        <h3 class="font-bold text-slate-900 text-lg leading-snug">{role.title}</h3>
        <p class="text-slate-600 text-sm mt-0.5">{role.company}</p>
        <p class="text-sm mt-1 font-medium flex items-center gap-2">
          {role.current && (
            <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>
          )}
          <span class={role.current ? 'text-red-500' : 'text-slate-400'}>{role.period}</span>
          {role.current && (
            <span class="text-xs bg-green-50 text-green-700 border border-green-200 px-2 py-0.5 rounded-full font-semibold">Current</span>
          )}
        </p>
        <p class="text-slate-600 text-sm mt-3 leading-relaxed">{role.description}</p>
        <div class="flex flex-wrap gap-1.5 mt-3">
          {role.skills.map((skill) => (
            <span class="px-2.5 py-1 bg-slate-100 text-slate-600 text-xs font-medium rounded-md">{skill}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
