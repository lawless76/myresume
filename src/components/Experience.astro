---
import { experience } from '@/data/experience';
---

<section id="experience" class="py-24 bg-slate-50">
  <div class="max-w-5xl mx-auto px-6">
    <div class="text-center mb-16">
      <span class="text-sm font-semibold text-accent-600 uppercase tracking-widest">Career</span>
      <h2 class="mt-2 text-3xl md:text-4xl font-bold text-slate-900">Work Experience</h2>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-slate-200 -translate-x-1/2 hidden md:block"></div>

      <div class="space-y-12">
        {experience.map((role, index) => (
          <div class={`relative md:grid md:grid-cols-2 md:gap-12 ${index % 2 === 0 ? '' : 'md:rtl'}`}>
            <!-- Timeline dot -->
            <div class="hidden md:block absolute left-1/2 top-6 -translate-x-1/2 w-4 h-4 rounded-full bg-accent-600 border-4 border-white shadow-sm z-10"></div>

            <!-- Date side -->
            <div class={`hidden md:flex ${index % 2 === 0 ? 'justify-end pr-8' : 'justify-start pl-8 md:ltr'} items-start pt-5`}>
              <div class="text-right md:ltr">
                <span class={`inline-flex items-center gap-1.5 text-sm font-semibold ${role.current ? 'text-accent-600' : 'text-slate-500'}`}>
                  {role.current && <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>}
                  {role.period}
                </span>
              </div>
            </div>

            <!-- Card side -->
            <div class={`${index % 2 === 0 ? 'md:pl-8' : 'md:pr-8 md:ltr'}`}>
              <div class="bg-white rounded-xl p-6 shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                <!-- Mobile: show period here -->
                <div class="md:hidden mb-3">
                  <span class={`inline-flex items-center gap-1.5 text-xs font-semibold ${role.current ? 'text-accent-600' : 'text-slate-500'}`}>
                    {role.current && <span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span>}
                    {role.period}
                  </span>
                </div>

                <div class="flex items-start justify-between gap-4 mb-3">
                  <div>
                    <h3 class="font-bold text-slate-900 text-lg">{role.title}</h3>
                    <p class="text-accent-600 font-medium text-sm mt-0.5">{role.company}</p>
                  </div>
                  {role.current && (
                    <span class="flex-shrink-0 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                      Current
                    </span>
                  )}
                </div>

                <p class="text-slate-600 text-sm leading-relaxed mb-4">{role.description}</p>

                <div class="flex flex-wrap gap-1.5">
                  {role.skills.map((skill) => (
                    <span class="px-2.5 py-1 rounded-md bg-slate-100 text-slate-600 text-xs font-medium">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
