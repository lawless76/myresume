---
import { site } from '@/data/site';
---

<section
  id="hero"
  class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-50 via-white to-blue-50 pt-16"
>
  <div class="max-w-5xl mx-auto px-6 py-24 text-center animate-fade-in">
    <!-- Availability badge -->
    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 text-green-700 text-sm font-medium mb-8 border border-green-200">
      <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
      Open to new opportunities
    </span>

    <!-- Name -->
    <h1 class="text-5xl md:text-7xl font-extrabold text-slate-900 mb-4 tracking-tight">
      {site.name}
    </h1>

    <!-- Title -->
    <p class="text-xl md:text-2xl font-medium text-accent-600 mb-6">
      {site.title}
    </p>

    <!-- Description -->
    <p class="max-w-2xl mx-auto text-lg text-slate-500 mb-10 leading-relaxed">
      {site.description}
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="#contact"
        class="px-6 py-3 bg-accent-600 text-white font-semibold rounded-lg hover:bg-accent-700 transition-colors shadow-sm hover:shadow-md"
      >
        Get in Touch
      </a>
      <a
        href="#experience"
        class="px-6 py-3 bg-white text-slate-700 font-semibold rounded-lg border border-slate-200 hover:border-accent-300 hover:text-accent-600 transition-colors shadow-sm"
      >
        View Experience
      </a>
      {site.linkedin && (
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-white text-slate-700 font-semibold rounded-lg border border-slate-200 hover:border-blue-300 hover:text-blue-700 transition-colors shadow-sm inline-flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
          LinkedIn
        </a>
      )}
    </div>

    <!-- Scroll indicator -->
    <div class="mt-20 flex justify-center">
      <a href="#about" class="text-slate-300 hover:text-accent-600 transition-colors animate-bounce">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>
</section>
