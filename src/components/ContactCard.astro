---
import { site } from '@/data/site';
---

<div class="bg-red-700 rounded-xl shadow-sm overflow-hidden">
  <div class="flex items-center justify-center gap-3 md:gap-6">

    <!-- Avatar -->
    <div class="p-2 md:pl-6 md:pr-3 md:py-6 flex items-center justify-center shrink-0">
      <div class="w-20 h-20 md:w-36 md:h-36 rounded-xl md:rounded-2xl bg-red-600 border-2 border-red-500 shadow-inner flex items-center justify-center select-none" aria-label="Profile photo placeholder">
        <span class="text-xl md:text-4xl font-extrabold text-white tracking-wide">CL</span>
      </div>
    </div>

    <!-- Info -->
    <div class="flex-none py-2 pr-2 md:py-6 md:pr-0 flex flex-col justify-center gap-1 md:gap-4 min-w-0 items-center text-center">

      <!-- Name & Title -->
      <div>
        <h1 class="text-base md:text-xl font-bold text-white leading-tight">{site.name}</h1>
        <p class="text-xs md:text-sm mt-0.5 leading-snug" style="color: rgba(255,255,255,0.75);">{site.title}</p>
      </div>

      <!-- Social icons -->
      <div class="flex items-end gap-0.5 md:gap-1 justify-center">
        {site.linkedin && (
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"
             class="card-icon hover:text-[#0077B5]" style="color: rgba(255,255,255,0.8);">
            <svg class="w-4 h-4 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            <span class="card-label">LinkedIn</span>
          </a>
        )}
        {site.github && (
          <a href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"
             class="card-icon hover:text-black" style="color: rgba(255,255,255,0.8);">
            <svg class="w-4 h-4 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            <span class="card-label">GitHub</span>
          </a>
        )}
        {site.discord && (
          <a href={site.discord} target="_blank" rel="noopener noreferrer" aria-label="Discord"
             class="card-icon hover:text-[#5865F2]" style="color: rgba(255,255,255,0.8);">
            <svg class="w-4 h-4 md:w-5 md:h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028 14.09 14.09 0 001.226-1.994.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
            <span class="card-label">Discord</span>
          </a>
        )}
      </div>

      <!-- Contact rows -->
      <div class="flex flex-col gap-0.5 md:gap-1 items-center">
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} class="contact-row">
          <svg class="contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="contact-value">{site.phone}</span>
        </a>
        <a href={`mailto:${site.email}`} class="contact-row">
          <svg class="contact-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="contact-value truncate">{site.email}</span>
        </a>
      </div>

      <!-- Download CV -->
      {site.cvUrl && (
        <a href={site.cvUrl} download
           class="flex items-center gap-2 px-3 py-1.5 md:px-4 md:py-2 font-semibold text-xs md:text-sm rounded-lg transition-colors"
           style="background-color: rgba(0,0,0,0.2); color: white;"
           onmouseover="this.style.backgroundColor='rgba(0,0,0,0.35)'"
           onmouseout="this.style.backgroundColor='rgba(0,0,0,0.2)'">
          <svg class="w-3.5 h-3.5 md:w-4 md:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Download CV
        </a>
      )}

    </div>
  </div>
</div>

<style>
  .card-icon {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 3px;
    padding: 6px;
    border-radius: 6px;
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .card-icon:hover { transform: translateY(-4px) scale(1.25); }
  .card-label {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }
  .card-icon:hover .card-label { opacity: 1; transform: translateY(0); }

  .contact-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 6px;
    border-radius: 5px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .contact-row:hover { background-color: #dc2626; }
  .contact-icon {
    width: 0.75rem;
    height: 0.75rem;
    color: rgba(255,255,255,0.65);
    flex-shrink: 0;
  }
  .contact-value {
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.9);
  }
</style>
