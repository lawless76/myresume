---
import { skills } from '@/data/skills';
---

<section id="skills" class="py-10 px-6 md:px-10 border-b border-slate-100">
  <div class="mb-8">
    <span class="text-xs font-semibold text-red-600 uppercase tracking-widest">Expertise</span>
    <h2 class="mt-1 text-2xl font-bold text-slate-900">Skills & Technologies</h2>
  </div>

  <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-5 justify-center">
    {skills.map((group) => (
      <div class="bg-slate-50 rounded-xl p-5 border border-slate-100 hover:border-red-200 hover:shadow-sm transition-all">
        <div class="flex items-center gap-3 mb-4">
          {group.iconUrl ? (
            <img
              src={group.iconUrl}
              alt={group.category}
              class="w-7 h-7 object-contain"
              loading="lazy"
            />
          ) : (
            <span class="text-2xl">{group.icon}</span>
          )}
          <h3 class="font-semibold text-slate-900 text-sm leading-tight">{group.category}</h3>
        </div>
        <div class="flex flex-wrap gap-2 justify-center">
          {group.items.map((item) => (
            <span class="px-3 py-1.5 bg-white rounded-lg text-slate-700 text-xs font-medium border border-slate-200 hover:border-red-300 hover:text-red-700 transition-colors">
              {item}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
