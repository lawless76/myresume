---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import ContactCard from '@/components/ContactCard.astro';
import { site } from '@/data/site';
---

<Layout>
  <!-- Page never scrolls — only the content card scrolls -->
  <div class="flex flex-col h-screen overflow-hidden">

    <!-- Full-width red nav -->
    <nav class="shrink-0 bg-red-700 shadow-sm z-20">
      <div class="flex items-center justify-center gap-0.5 px-4 h-12 overflow-x-auto scrollbar-none">
        {site.nav.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 text-sm font-medium text-red-100 hover:text-white hover:bg-red-600 rounded-md transition-colors whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </div>
    </nav>

    <!-- Content area: slate background, no overflow -->
    <div class="flex-1 overflow-hidden bg-slate-200 flex gap-4 p-4 md:p-6">

      <!-- Contact card (xl screens only) -->
      <aside class="hidden xl:flex xl:flex-col w-56 shrink-0">
        <ContactCard />
      </aside>

      <!-- Centered card — scrolls internally, no browser scroll -->
      <div class="flex-1 flex justify-center overflow-hidden">
        <div class="w-full max-w-3xl overflow-y-auto rounded-xl bg-white shadow-sm">
          <About />
          <Experience />
          <Skills />
          <Projects />
          <Education />
          <Contact />
        </div>
      </div>

    </div>

    <!-- Footer: always visible at bottom -->
    <Footer />

  </div>
</Layout>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
