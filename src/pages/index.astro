---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import ContactCard from '@/components/ContactCard.astro';
import { site } from '@/data/site';
---

<Layout>
  <div class="flex flex-col h-[100dvh] overflow-hidden bg-slate-200">

    <!-- Floating nav card -->
    <div class="shrink-0 px-4 md:px-6 pt-4 pb-3">
      <nav class="bg-red-700 rounded-xl shadow-sm z-20 max-w-3xl mx-auto">
        <div class="flex items-center justify-start md:justify-center gap-0.5 px-4 h-12 overflow-x-auto scrollbar-none">
          {site.nav.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 text-sm font-medium text-red-100 hover:text-white hover:bg-red-600 rounded-md transition-colors whitespace-nowrap"
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </div>

    <!-- Below-nav layout: contact card + scrolling content card -->
    <div class="flex-1 min-h-0 flex flex-col">

      <!-- Contact card: always visible at top, never scrolls -->
      <div class="shrink-0 px-4 md:px-6 pb-3">
        <div class="max-w-3xl mx-auto">
          <ContactCard />
        </div>
      </div>

      <!-- Content card: fills remaining height, rounded corners always visible, content scrolls inside -->
      <div class="flex-1 min-h-0 px-4 md:px-6 pb-6">
        <div class="max-w-3xl mx-auto h-full bg-white rounded-xl shadow-sm overflow-y-auto text-center content-scroll">
          <About />
          <Experience />
          <Skills />
          <Projects />
          <Education />
          <Contact />
        </div>
      </div>

    </div>

    <!-- Footer: always visible at bottom -->
    <Footer />

  </div>
</Layout>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* Subtle rounded scrollbar for the content card */
  .content-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }
  .content-scroll::-webkit-scrollbar {
    width: 5px;
  }
  .content-scroll::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 9999px;
    margin: 12px; /* keeps bar away from the card's rounded corners */
  }
  .content-scroll::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 9999px;
  }
  .content-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.28);
  }
</style>

