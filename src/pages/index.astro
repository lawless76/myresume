---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
---

<Layout>
  <!-- Two-column layout: sidebar left, flex-col right panel -->
  <div class="lg:flex lg:h-screen">

    <!-- Left: sticky sidebar -->
    <Sidebar />

    <!-- Right: flex column so footer is always visible -->
    <div class="flex-1 flex flex-col lg:overflow-hidden">

      <!-- Sticky red nav bar -->
      <nav class="shrink-0 bg-red-700 shadow-sm z-20">
        <div class="flex items-center gap-0.5 px-4 h-12 overflow-x-auto scrollbar-none">
          {site.nav.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 text-sm font-medium text-red-100 hover:text-white hover:bg-red-600 rounded-md transition-colors whitespace-nowrap"
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>

      <!-- Scrollable main content -->
      <main class="flex-1 overflow-y-auto bg-white">
        <About />
        <Experience />
        <Skills />
        <Projects />
        <Education />
        <Contact />
      </main>

      <!-- Footer: always visible at bottom -->
      <Footer />

    </div>
  </div>
</Layout>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
