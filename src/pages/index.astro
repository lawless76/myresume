---
import Layout from '@/layouts/Layout.astro';
import Sidebar from '@/components/Sidebar.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
---

<Layout>
  <!-- Two-column layout: sidebar fixed left, content scrollable right -->
  <div class="lg:flex lg:h-screen">

    <!-- Left: sticky sidebar -->
    <Sidebar />

    <!-- Right: scrollable content panel -->
    <div class="flex-1 bg-white lg:overflow-y-auto" id="scroll-content">

      <!-- Sticky section nav -->
      <nav class="sticky top-0 z-20 bg-white/95 backdrop-blur border-b border-slate-200 shadow-sm">
        <div class="flex items-center gap-0.5 px-6 h-13 overflow-x-auto scrollbar-none">
          {site.nav.map((link) => (
            <a
              href={link.href}
              class="px-3 py-2 text-sm font-medium text-slate-600 hover:text-red-700 hover:bg-red-50 rounded-md transition-colors whitespace-nowrap"
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>

      <!-- Main sections -->
      <main>
        <About />
        <Experience />
        <Skills />
        <Projects />
        <Education />
        <Contact />
      </main>

      <!-- Footer -->
      <Footer />

    </div>
  </div>
</Layout>

<style>
  /* Hide scrollbar on the nav on small screens */
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* On desktop, make the right panel fill the height and scroll independently */
  @media (min-width: 1024px) {
    #scroll-content {
      height: 100vh;
    }
  }
</style>
