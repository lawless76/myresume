---
import Layout from '@/layouts/Layout.astro';
import About from '@/components/About.astro';
import Experience from '@/components/Experience.astro';
import Skills from '@/components/Skills.astro';
import Projects from '@/components/Projects.astro';
import Education from '@/components/Education.astro';
import Contact from '@/components/Contact.astro';
import Footer from '@/components/Footer.astro';
import ContactCard from '@/components/ContactCard.astro';
import { site } from '@/data/site';
---

<Layout>
  <div class="flex flex-col h-[100dvh] overflow-hidden" style="background: linear-gradient(135deg, #cbd5e1 0%, #e2e8f0 40%, #c7d2e8 100%);">

    <!-- Floating nav card -->
    <div class="shrink-0 px-4 md:px-6 pt-4 pb-3 relative z-20">
      <nav class="bg-red-700 rounded-xl shadow-sm max-w-3xl mx-auto relative" id="main-nav">

        <!-- Nav bar row -->
        <div class="flex items-center px-2 h-12">

          <!-- Links (hidden when overflowing) -->
          <div id="nav-links" class="flex items-center justify-center gap-0.5 flex-1 overflow-hidden">
            {site.nav.map((link) => (
              <a
                href={link.href}
                class="nav-link px-3 py-2 text-sm font-medium text-red-100 hover:text-white hover:bg-red-600 rounded-md transition-colors whitespace-nowrap shrink-0"
              >
                {link.label}
              </a>
            ))}
          </div>

          <!-- Hamburger button (shown when links overflow) -->
          <button
            id="nav-burger"
            class="hidden p-2 rounded-md text-red-100 hover:text-white hover:bg-red-600 transition-colors ml-auto"
            aria-label="Open menu"
            aria-expanded="false"
          >
            <svg id="icon-menu" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
            <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Dropdown: absolute, right-aligned, only as wide as the longest item -->
        <div id="nav-dropdown" class="hidden absolute right-0 top-full mt-2 bg-red-700 rounded-xl shadow-lg overflow-hidden justify-right w-max z-30">
          {site.nav.map((link) => (
            <a
              href={link.href}
              class="dropdown-link block px-5 py-3 text-sm font-medium text-red-100 hover:text-white hover:bg-red-600 transition-colors"
            >
              {link.label}
            </a>
          ))}
        </div>

      </nav>
    </div>

    <!-- Below-nav layout: contact card + scrolling content card -->
    <div class="flex-1 min-h-0 flex flex-col">

      <!-- Contact card: always visible at top, never scrolls -->
      <div class="shrink-0 px-4 md:px-6 pb-3">
        <div class="max-w-3xl mx-auto">
          <ContactCard />
        </div>
      </div>

      <!-- Content card: fills remaining height, rounded corners always visible, content scrolls inside -->
      <div class="flex-1 min-h-0 px-4 md:px-6 pb-6">
        <div class="max-w-3xl mx-auto h-full bg-white rounded-xl shadow-sm overflow-y-auto text-center content-scroll">
          <About />
          <Experience />
          <Skills />
          <Projects />
          <Education />
          <Contact />
        </div>
      </div>

    </div>

    <!-- Footer: always visible at bottom -->
    <Footer />

  </div>
</Layout>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /* Subtle rounded scrollbar for the content card */
  .content-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }
  .content-scroll::-webkit-scrollbar {
    width: 5px;
  }
  .content-scroll::-webkit-scrollbar-track {
    background: transparent;
    border-radius: 9999px;
    margin: 12px;
  }
  .content-scroll::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 9999px;
  }
  .content-scroll::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.28);
  }
</style>

<script>
  const navLinks   = document.getElementById('nav-links')!;
  const burger     = document.getElementById('nav-burger')!;
  const dropdown   = document.getElementById('nav-dropdown')!;
  const iconMenu   = document.getElementById('icon-menu')!;
  const iconClose  = document.getElementById('icon-close')!;

  function updateNav() {
    // Temporarily show links to measure their natural width
    navLinks.classList.remove('hidden');
    burger.classList.add('hidden');

    const overflowing = navLinks.scrollWidth > navLinks.clientWidth;

    if (overflowing) {
      navLinks.classList.add('hidden');
      burger.classList.remove('hidden');
    } else {
      // Make sure dropdown is also closed when links are visible
      dropdown.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      burger.setAttribute('aria-expanded', 'false');
    }
  }

  burger.addEventListener('click', () => {
    const isOpen = !dropdown.classList.contains('hidden');
    dropdown.classList.toggle('hidden', isOpen);
    iconMenu.classList.toggle('hidden', !isOpen);
    iconClose.classList.toggle('hidden', isOpen);
    burger.setAttribute('aria-expanded', String(!isOpen));
  });

  // Close dropdown when a link is clicked
  dropdown.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      dropdown.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      burger.setAttribute('aria-expanded', 'false');
    });
  });

  // Check on load and whenever the viewport/zoom changes.
  // Observe the nav card itself — navLinks is hidden in burger mode so
  // a ResizeObserver on it would never fire when zooming back out.
  updateNav();
  new ResizeObserver(updateNav).observe(document.getElementById('main-nav')!);
  window.addEventListener('resize', updateNav);
</script>
